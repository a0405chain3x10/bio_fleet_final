{
  "name": "biofleet",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node src/experiments/bench.ts",
    "perf": "node src/experiments/perf.ts",
    "agent:node": "node src/node/agent-node.ts",
    "build:docs": "vite build --outDir docs --emptyOutDir && touch docs/.nojekyll"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  }
}
